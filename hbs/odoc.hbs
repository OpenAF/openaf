<style>
.tabs .indicator { background-color: #ff9800 }
.odoc-text { white-space: pre-wrap; overflow-wrap: anywhere }
</style>
<div class="row">
  <form class="col s12" id="searchForm">
    <div class="input-field col s12">
      <input id="search" type="text" value="{{id}}">
      <label for="search">Search terms</label>
    </div>
  </form>
</div>
<div id="odocData" hidden data-uri-prefix="{{uriPrefix}}">
{{#each terms}}
  <span data-id="{{id}}" data-key="{{key}}"></span>
{{/each}}
</div>
<div class="row">
  <div class="col s12 m12">
    <div class="card" id="keyCard" style="display: none">
      <div class="card-content" id="keyCardContent"></div>
    </div>
  </div>
  <div class="collection col s12 m12" id="termCollection"></div>
</div>
<script>
(function() {
  var list = [];
  $("#odocData span").each(function() {
    list.push({ id: $(this).attr("data-id"), key: $(this).attr("data-key") });
  });
  var uriPrefix = $("#odocData").attr("data-uri-prefix");
  var revision = 0;

  function message(text) {
    $("#keyCardContent").empty().append($("<p>").text(text));
    $("#keyCard").show();
  }

  function update(selected) {
    var current = ++revision;
    var searchVal = $("#search").val();
    var lower = searchVal.toLowerCase();
    var matches = list.filter(function(item) { return item.key.toLowerCase().indexOf(lower) >= 0; });
    $("#keyCardContent").empty();
    $("#keyCard").hide();
    $("#termCollection").empty().show();
    matches.forEach(function(item) {
      $("<a>", { href: "#", "class": "odocterm collection-item grey-text text-darken-1" })
        .text(item.key + " (" + item.id + ")")
        .on("click", function(event) {
          event.preventDefault();
          $("#search").val(item.key).trigger("focus");
          update(item);
        }).appendTo("#termCollection");
    });
    if (!selected && matches.length == 1) selected = matches[0];
    if (!selected) {
      if (matches.length == 0) message("Term not found.");
      return;
    }
    var url = uriPrefix + "/odocKey?q=" + encodeURIComponent(selected.key) + "&id=" + encodeURIComponent(selected.id);
    $.getJSON(url, function(entry) {
      if (current != revision) return;
      if (!entry || typeof entry.text !== "string" || typeof entry.fullkey !== "string") {
        message(entry && entry.error ? entry.error : "Term not found.");
        return;
      }
      var content = $("#keyCardContent").empty();
      $("<span>", { "class": "card-title thin" }).text(entry.key).appendTo(content);
      var body = $("<div>", { "class": "card-action" }).appendTo(content);
      $("<h5>", { "class": "grey-text text-darken-1 odoc-text" }).text(entry.fullkey).appendTo(body);
      $("<p>", { "class": "odoc-text" }).text(entry.text).appendTo(body);
      $("#keyCard").show();
      $("#termCollection").hide();
    }).fail(function() {
      if (current == revision) message("Unable to load documentation.");
    });
  }
  $("#search").on("input", function() { update(); });
  $("#searchForm").on("submit", function(event) { event.preventDefault(); update(); });
  update();
})();
</script>
